rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────
    // HELPERS
    // ─────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }


    // ─────────────────────────────────────────────
    // USERS (Private Account Information)
    // ─────────────────────────────────────────────

    match /users/{uid} {
      // Least-privilege: user accounts (containing email, fcmTokens, etc.)
      // can only be read by their owner or an administrator.
      allow read: if isOwner(uid) || isAdmin();

      // User can create their initial profile on registration.
      // They cannot grant themselves an admin role or pre-verified status.
      allow create: if isOwner(uid)
        && request.resource.data.role in ['buyer', 'seller']
        && (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false)
        && (!request.resource.data.keys().hasAny(['gistSuspended']) || request.resource.data.gistSuspended == false)
        && (!request.resource.data.keys().hasAny(['sellerRequestStatus']) || request.resource.data.sellerRequestStatus == 'pending')
        && (!request.resource.data.keys().hasAny(['verificationStatus']) || request.resource.data.verificationStatus == 'pending');

      // Normal users can update non-privileged fields (e.g. name, phone, fcmTokens, bio).
      // They CANNOT modify role, verified, or gistSuspended flags, and can only request 'pending' status.
      // Admins can update any user record.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'verified', 'gistSuspended', 'gistSuspendedReason', 'gistSuspendedAt', 'gistSuspendedBy'])
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerRequestStatus'])
              || request.resource.data.sellerRequestStatus == 'pending'
              || request.resource.data.sellerRequestStatus == resource.data.sellerRequestStatus)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['verificationStatus'])
              || request.resource.data.verificationStatus == 'pending'
              || request.resource.data.verificationStatus == resource.data.verificationStatus)
        );

      // Account owner or admin can delete the profile document.
      allow delete: if isOwner(uid) || isAdmin();
    }


    // ─────────────────────────────────────────────
    // PUBLIC PROFILES (Marketplace Facing Info)
    // ─────────────────────────────────────────────

    match /publicProfiles/{uid} {
      // Public marketplace information (name, phone, school, verified, bio) is publicly readable.
      allow read: if true;

      // Created by account owner on registration or backfilled by admin/owner.
      allow create: if (isOwner(uid)
        && (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false))
        || isAdmin();

      // Owner can update their profile information, but cannot self-verify or modify roles.
      // Admins have full write privileges.
      allow update: if isAdmin()
        || (
          isOwner(uid)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verified', 'role'])
        );

      allow delete: if isOwner(uid) || isAdmin();
    }


    // ─────────────────────────────────────────────
    // PRODUCTS
    // ─────────────────────────────────────────────

    match /products/{productId} {
      // Marketplace browsing is public.
      allow read: if true;

      // Seller must own the product being created.
      // Prevents forging the sellerVerified badge unless already verified in the users collection.
      allow create: if isSignedIn()
        && request.auth.uid == request.resource.data.sellerId
        && (
          !request.resource.data.keys().hasAny(['sellerVerified'])
          || request.resource.data.sellerVerified == false
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.verified == true
          )
          || isAdmin()
        );

      // Sellers can update their own products, but cannot change sellerId or sellerVerified.
      // Signed-in users can increment the views counter.
      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == resource.data.sellerId
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['sellerId', 'sellerVerified'])
            || (
              request.resource.data.sellerVerified == resource.data.sellerVerified
              && request.resource.data.sellerId == resource.data.sellerId
            )
          )
        )
        || (
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
        );

      // Only owner or admin can delete.
      allow delete: if isSignedIn()
        && (
          request.auth.uid == resource.data.sellerId
          || isAdmin()
        );
    }


    // ─────────────────────────────────────────────
    // VERIFICATION REQUESTS
    // ─────────────────────────────────────────────

    match /verification_requests/{reqId} {
      // Authenticated users can submit a verification request.
      allow create: if isSignedIn();

      // Only request owner or admin can read.
      allow read: if isSignedIn()
        && (request.auth.uid == resource.data.userId || isAdmin());

      allow update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // RATINGS
    // ─────────────────────────────────────────────

    match /ratings/{ratingId} {
      // Authenticated users can view ratings.
      allow read: if isSignedIn();

      // Buyer must be authenticated and own the rating.
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      // Only the buyer who created the rating or an admin can modify/delete it.
      allow update, delete: if isSignedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || isAdmin()
        );
    }


    // ─────────────────────────────────────────────
    // SAVED ITEMS
    // ─────────────────────────────────────────────

    match /savedItems/{docId} {
      // User can read their own saved items.
      allow read: if isSignedIn()
        && resource.data.buyerId == request.auth.uid;

      // User can create only their own saved item.
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      // User can update/delete only their own saved item.
      allow update, delete: if isSignedIn()
        && resource.data.buyerId == request.auth.uid;
    }


    // ─────────────────────────────────────────────
    // INTERESTS
    // ─────────────────────────────────────────────

    match /interests/{interestId} {
      // Buyer creates their own interest request.
      allow create: if isSignedIn()
        && request.resource.data.buyerId == request.auth.uid;

      // Buyer can read their own interest.
      // Seller can read interests for their products.
      allow read: if isSignedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || resource.data.sellerId == request.auth.uid
          || isAdmin()
        );

      // Seller can only update the "seen" field.
      // Buyer/admin can update their own/admin records as needed.
      allow update: if isSignedIn()
        && (
          isAdmin()
          || (
            resource.data.sellerId == request.auth.uid
            && request.resource.data.diff(resource.data)
              .affectedKeys()
              .hasOnly(['seen'])
          )
          || resource.data.buyerId == request.auth.uid
        );

      // Buyer or admin can delete an interest.
      allow delete: if isSignedIn()
        && (
          resource.data.buyerId == request.auth.uid
          || isAdmin()
        );
    }




    // ─────────────────────────────────────────────
    // CAMPAIGNS (Homepage Promotional Banners)
    // ─────────────────────────────────────────────

    match /campaigns/{campaignId} {
      // Banners are publicly visible on homepage.
      allow read: if true;

      // Only admins can create, update, or delete campaigns.
      allow write: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // ADS (Paid homepage banners — ₦500 / week)
    // ─────────────────────────────────────────────

    match /ads/{adId} {
      function adOwner() {
        return isSignedIn() && resource.data.ownerId == request.auth.uid;
      }

      function changed() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      // Anyone (incl. guests) may bump exactly one counter by exactly 1 on a live ad.
      function isCounterBump() {
        return resource.data.status == 'active'
          && (
            (changed().hasOnly(['impressions'])
              && request.resource.data.impressions == resource.data.impressions + 1)
            || (changed().hasOnly(['clicks'])
              && request.resource.data.clicks == resource.data.clicks + 1)
          );
      }

      // Live ads are public; owners see their own; admins see all.
      allow read: if resource.data.status == 'active' || adOwner() || isAdmin();

      // Advertisers can only create unpaid, correctly priced ads for themselves.
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending_payment'
        && request.resource.data.weeks is int
        && request.resource.data.weeks >= 1
        && request.resource.data.weeks <= 4
        && request.resource.data.amount == request.resource.data.weeks * 500
        && request.resource.data.impressions == 0
        && request.resource.data.clicks == 0
        && request.resource.data.startDate == null
        && request.resource.data.endDate == null
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 80
        && request.resource.data.imageUrl is string
        && request.resource.data.linkUrl is string;

      allow update: if isAdmin()
        // Owner may tweak content / payment ref while still unpaid — never status, dates or price.
        || (adOwner()
            && resource.data.status == 'pending_payment'
            && changed().hasOnly(['paymentRef', 'title', 'subtitle', 'imageUrl', 'linkType', 'linkUrl']))
        || isCounterBump();

      allow delete: if isAdmin()
        || (adOwner() && resource.data.status == 'pending_payment');
    }


    // ─────────────────────────────────────────────
    // CHATS & MESSAGES
    // ─────────────────────────────────────────────

    match /chats/{chatId} {
      function isChatParticipant() {
        return isSignedIn() && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      }

      allow read: if isChatParticipant() || isAdmin();

      allow create: if isSignedIn()
        && (request.resource.data.buyerId == request.auth.uid || request.resource.data.sellerId == request.auth.uid);

      // Participants cannot change ownership or product linkage
      allow update: if (isChatParticipant()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['buyerId', 'sellerId', 'productId']))
        || isAdmin();

      allow delete: if isAdmin();

      match /messages/{messageId} {
        function chatExists() {
          return exists(/databases/$(database)/documents/chats/$(chatId));
        }
        function getChat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }
        function isChatParticipantForMsg() {
          return isSignedIn() && chatExists() && (getChat().buyerId == request.auth.uid || getChat().sellerId == request.auth.uid);
        }

        // Only verified chat participants or admin can read messages
        allow read: if isChatParticipantForMsg() || isAdmin();

        // Chat document must exist first; sender must be an authenticated participant; senderId must match auth UID
        allow create: if isSignedIn()
          && chatExists()
          && isChatParticipantForMsg()
          && request.resource.data.senderId == request.auth.uid;

        // Normal users cannot tamper with sent messages; admins have moderation power
        allow update, delete: if isAdmin();
      }
    }


    // ─────────────────────────────────────────────
    // ANALYTICS EVENTS (Telemetry & Event Tracking)
    // ─────────────────────────────────────────────

    match /analytics_events/{eventId} {
      // Anyone (including guests) can log defined event types.
      // Signed-in users cannot log events on behalf of someone else.
      allow create: if request.resource.data.eventType in [
          'product_viewed', 'whatsapp_clicked', 'in_app_ask_clicked', 'seller_replied', 'referral_signup'
        ]
        && request.resource.data.keys().hasOnly(['eventType', 'userId', 'sellerId', 'productId', 'metadata', 'date', 'createdAt'])
        && request.resource.data.userId is string
        && (
          (isSignedIn() && request.resource.data.userId == request.auth.uid)
          || (!isSignedIn() && request.resource.data.userId.matches('^anon_.*'))
        );
      // Only admins can read analytics logs
      allow read: if isAdmin();
      allow update, delete: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // REFERRALS & GIVEAWAY REWARDS
    // Writes are server-only (/api/referral uses the Admin SDK, which bypasses
    // these rules). Clients may only read their own records.
    // ─────────────────────────────────────────────

    match /referrals/{referralId} {
      allow read: if isSignedIn()
        && (resource.data.referrerId == request.auth.uid || resource.data.referredUserId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /referral_blocked/{docId} {
      allow read, delete: if isAdmin();
      allow create, update: if isAdmin();
    }

    match /giveaway_winners/{winnerId} {
      allow read: if isSignedIn()
        && (winnerId == request.auth.uid || isAdmin());
      // Winner records are created only by the server endpoint or an admin
      allow create: if isAdmin();
      // Winner may add/edit their own bank details; admin manages payout status.
      allow update: if isAdmin()
        || (
          isOwner(winnerId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['bankDetails'])
          && resource.data.status != 'Paid'
        );
      allow delete: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // GLOBAL SETTINGS & BUDGET CAPS
    // ─────────────────────────────────────────────

    // ─────────────────────────────────────────────
    // GLOBAL SETTINGS & BUDGET CAPS
    // ─────────────────────────────────────────────

    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }


    // ─────────────────────────────────────────────
    // MARKET-U GIST SOCIAL SYSTEM
    // ─────────────────────────────────────────────

    // Posts (Gists, Confessions, Hot Takes, Polls, Reviews)
    match /gist_posts/{postId} {
      // Public feeds can read posts (removed posts are filtered out client-side and scrubbed on soft-delete).
      allow read: if true;

      // Only signed-in users can create posts.
      // For normal posts, authorId must match request auth UID.
      // For anonymous posts (isAnonymous == true), authorId on the public doc may be null (stored privately in gist_private_authors).
      // Also enforce that a suspended user cannot post.
      allow create: if isSignedIn()
        && (
          request.resource.data.authorId == request.auth.uid
          || (request.resource.data.isAnonymous == true && request.resource.data.authorId == null)
        )
        && request.resource.data.status == 'active'
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['gistSuspended'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gistSuspended != true
        );

      // Updates:
      // 1. Admins have full moderation permissions (e.g., status to 'removed').
      // 2. Author (direct or via gist_private_authors) can edit their own post content or soft-delete it, but cannot transfer authorship or change originating school.
      // 3. Authenticated users can update engagement counters (reactionsCount, commentsCount, sharesCount, poll).
      allow update: if isAdmin()
        || (
          isSignedIn()
          && (
            (
              (
                resource.data.authorId == request.auth.uid
                || (
                  resource.data.isAnonymous == true
                  && exists(/databases/$(database)/documents/gist_private_authors/$(postId))
                  && get(/databases/$(database)/documents/gist_private_authors/$(postId)).data.authorId == request.auth.uid
                )
              )
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authorId', 'schoolName', 'schoolShort'])
            )
            || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionsCount', 'commentsCount', 'sharesCount', 'poll'])
          )
        );

      // Only author or admin can delete.
      allow delete: if isSignedIn()
        && (
          resource.data.authorId == request.auth.uid
          || (
            resource.data.isAnonymous == true
            && exists(/databases/$(database)/documents/gist_private_authors/$(postId))
            && get(/databases/$(database)/documents/gist_private_authors/$(postId)).data.authorId == request.auth.uid
          )
          || isAdmin()
        );
    }

    // Private Author Records for Anonymous Gists & Comments (Never publicly readable)
    match /gist_private_authors/{targetId} {
      allow read: if isSignedIn()
        && (resource.data.authorId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Reactions (Love, Haha, Fire, Wild)
    match /gist_reactions/{reactionId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Poll Votes (One vote per user per poll)
    match /gist_votes/{voteId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow update: if false; // Once cast, votes are immutable
      allow delete: if isAdmin();
    }

    // Comments & Replies
    match /gist_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn()
        && (
          request.resource.data.authorId == request.auth.uid
          || (request.resource.data.isAnonymous == true && request.resource.data.authorId == null)
        )
        && request.resource.data.status == 'active'
        && (
          !exists(/databases/$(database)/documents/users/$(request.auth.uid))
          || !get(/databases/$(database)/documents/users/$(request.auth.uid)).data.keys().hasAny(['gistSuspended'])
          || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.gistSuspended != true
        );
      allow update: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.authorId == request.auth.uid
            || (
              resource.data.isAnonymous == true
              && exists(/databases/$(database)/documents/gist_private_authors/$(commentId))
              && get(/databases/$(database)/documents/gist_private_authors/$(commentId)).data.authorId == request.auth.uid
            )
          )
        );
      allow delete: if isAdmin()
        || (
          isSignedIn()
          && (
            resource.data.authorId == request.auth.uid
            || (
              resource.data.isAnonymous == true
              && exists(/databases/$(database)/documents/gist_private_authors/$(commentId))
              && get(/databases/$(database)/documents/gist_private_authors/$(commentId)).data.authorId == request.auth.uid
            )
          )
        );
    }

    // Reports (User reports for harassment, spam, doxxing, etc.)
    match /gist_reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid;
      allow read: if isSignedIn()
        && (resource.data.reporterId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Moderation Audit Log & Actions
    match /gist_moderation_actions/{actionId} {
      allow read, write: if isAdmin();
    }

    // Gist Social Notifications
    match /gist_notifications/{notifId} {
      allow read: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid;
      allow update: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || request.resource.data.actorId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn()
        && (resource.data.recipientId == request.auth.uid || isAdmin());
    }

    // Saved / Bookmarked Gists
    match /gist_saved/{saveId} {
      allow read: if isSignedIn()
        && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource.data.userId == request.auth.uid || isAdmin());
    }


    // ─────────────────────────────────────────────
    // DENY EVERYTHING ELSE
    // ─────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}